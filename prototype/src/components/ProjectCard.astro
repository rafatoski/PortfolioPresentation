---
import { ExternalLink, FolderGit2 } from '@lucide/astro';

interface Props {
  name: string;
  role: string;
  image: string;
  href?: string;
  repository?: string;
  featured?: boolean;
  imageClass?: string;
}

const { name, role, image, href, repository, featured = false, imageClass = '' } = Astro.props;
---

<article class:list={["surface-card group overflow-hidden border border-line bg-panel", featured ? "rounded-[2rem]" : "rounded-2xl"]} data-project-card>
  <div class:list={["relative overflow-hidden bg-panel-soft", featured ? "aspect-[4/3]" : "aspect-[16/11]"]} data-project-media>
    <img class:list={["h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.025]", imageClass]} src={image} alt={`${name} project preview`} width="800" height="600" loading="lazy" decoding="async" />
    {featured && <span class="absolute top-4 left-4 rounded-full border border-white/20 bg-night/75 px-3 py-1.5 text-[0.65rem] font-bold tracking-[0.15em] uppercase backdrop-blur sm:top-5 sm:left-5">Featured</span>}
  </div>
  <div class:list={[featured ? "p-7 sm:p-8" : "p-5"]}>
    <div class="flex items-start justify-between gap-5">
      <div class="min-w-0">
        <h3 class:list={["font-display font-semibold tracking-[-0.03em]", featured ? "text-2xl sm:text-3xl" : "text-lg"]}>{name}</h3>
        <p class="mt-2 text-sm leading-6 text-muted">{role}</p>
      </div>
      {href && <a class="interactive-link grid size-12 shrink-0 place-items-center rounded-full border border-line hover:border-accent hover:bg-accent hover:text-night" href={href} target="_blank" rel="noopener" aria-label={`Open ${name} in a new tab`}><ExternalLink size={19} stroke-width={1.8} aria-hidden="true" /></a>}
    </div>
    {repository && <a class="interactive-link mt-5 inline-flex min-h-11 items-center gap-2 rounded-full text-sm font-semibold text-accent hover:text-ink" href={repository} target="_blank" rel="noopener"><FolderGit2 size={18} stroke-width={1.8} aria-hidden="true" />Public repository <ExternalLink size={14} stroke-width={1.8} aria-hidden="true" /></a>}
  </div>
</article>
